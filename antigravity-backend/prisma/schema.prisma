generator client {
  provider = "prisma-client-js"
}

// NOTE: using .env for DB URL
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DeviceStatus {
  CLEAN
  SUSPICIOUS
  STOLEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String                @id @default(uuid())
  email                 String?               @unique
  password              String?
  role                  Role                  @default(USER)
  plan                  String                @default("FREE") // "FREE", "PRO"
  searchLimit           Int                   @default(1)
  searchesLeft          Int                   @default(1)
  reportLimit           Int                   @default(0)
  reportsLeft           Int                   @default(0)
  isPro                 Boolean               @default(false)
  subscriptionExpiresAt DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reports               Report[]
  SubscriptionRequest   SubscriptionRequest[]
}

model Device {
  imei       String       @id
  status     DeviceStatus @default(CLEAN)
  riskScore  Int          @default(0) // 0-100
  riskLevel  RiskLevel    @default(LOW)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reports    Report[]
  searchLogs SearchLog[]
}

model Report {
  id                     String       @id @default(uuid())
  imei                   String
  device                 Device       @relation(fields: [imei], references: [imei])
  reporterIp             String?
  userId                 String?
  user                   User?        @relation(fields: [userId], references: [id])
  date                   DateTime     @default(now())
  location               String?
  description            String?
  contactNumber          String?
  deviceName             String?
  extractedFromGd        Boolean      @default(false)
  aiExtractionConfidence Float?
  status                 ReportStatus @default(PENDING)
  trustWeight            Int          @default(1) // e.g. 1 (anonymous), 2 (verified email), 5 (evidence)
  gdImage                String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model SearchLog {
  id        String   @id @default(uuid())
  imei      String
  device    Device   @relation(fields: [imei], references: [imei])
  ip        String?
  location  String?
  timestamp DateTime @default(now())
}

model SubscriptionRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  userEmail     String
  planName      String   // "1 Month", "3 Months", "6 Months", "12 Months"
  price         Int      // 49, 99, 259, 999
  trxCode       String   @unique
  bkashLastFour String
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
