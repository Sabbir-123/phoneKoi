generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DeviceStatus {
  CLEAN
  SUSPICIOUS
  STOLEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  RECOVERED
}

model User {
  id                    String                @id @default(uuid())
  email                 String?               @unique
  password              String?
  role                  Role                  @default(USER)
  displayName           String?
  phone                 String?               @unique
  normalizedPhone       String?
  whatsapp              String?
  telegramChatId        String?
  address               String?
  avatarUrl             String?
  isProfileComplete     Boolean               @default(false)
  plan                  String                @default("FREE") // "FREE", "PRO", "6 Months Pro", etc.
  searchLimit           Int                   @default(1)
  searchesLeft          Int                   @default(1)
  reportLimit           Int                   @default(0)
  reportsLeft           Int                   @default(0)
  isPro                 Boolean               @default(false)
  subscriptionExpiresAt DateTime?
  hasDismissedPromo     Boolean               @default(false)
  hasClaimedPromo       Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reports               Report[]
  searchLogs            SearchLog[]
  SubscriptionRequest   SubscriptionRequest[]
  searchEvents          SearchEvent[]         @relation("UserSearchEvents")
  sellerReports         SellerReport[]
  ownerMessages         OwnerMessage[]
}

model Device {
  imei         String         @id
  brand        String?
  model        String?
  deviceName   String?
  status       DeviceStatus   @default(CLEAN)
  riskScore    Int            @default(0) // 0-100
  riskLevel    RiskLevel      @default(LOW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reports      Report[]
  searchLogs   SearchLog[]
  searchEvents SearchEvent[]
}

model Report {
  id                     String       @id @default(uuid())
  imei                   String
  device                 Device       @relation(fields: [imei], references: [imei], onDelete: Cascade)
  reporterIp             String?
  userId                 String?
  user                   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail              String?
  date                   DateTime     @default(now())
  location               String?
  description            String?
  contactNumber          String?
  deviceName             String?
  brand                  String?
  model                  String?
  reportType             String       @default("STOLEN") // "LOST" | "STOLEN"
  lossDate               DateTime?
  policeGdNumber         String?
  policeStation          String?
  notificationPreferences String[]    @default(["IN_APP", "EMAIL", "WHATSAPP", "SMS"])
  extractedFromGd        Boolean      @default(false)
  aiExtractionConfidence Float?
  status                 ReportStatus @default(PENDING)
  trustWeight            Int          @default(1)
  gdImage                String?
  gdStoragePath          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([imei])
  @@index([userId])
}

model SearchLog {
  id        String   @id @default(uuid())
  imei      String
  device    Device   @relation(fields: [imei], references: [imei], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  ip        String?
  location  String?
  timestamp DateTime @default(now())

  @@index([imei])
  @@index([userId])
}

model SearchEvent {
  id              String       @id @default(uuid())
  imei            String
  device          Device       @relation(fields: [imei], references: [imei], onDelete: Cascade)
  ownerId         String?
  owner           User?        @relation("UserSearchEvents", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerEmail      String
  maskedImei      String
  deviceBrand     String?
  deviceModel     String?
  deviceName      String?
  searchResult    String       @default("STOLEN")
  ip              String?
  latitude        Float?
  longitude       Float?
  accuracyRadius  Float?
  locationSource  String?
  locationName    String?
  policeGdNumber  String?
  isRead          Boolean      @default(false)
  notifications   Json?
  timestamp       DateTime     @default(now())

  @@index([ownerEmail])
  @@index([imei])
}

model SubscriptionRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail     String
  planName      String   // "1 Month", "3 Months", "6 Months", "12 Months"
  price         Int      // 49, 99, 259, 999
  trxCode       String   @unique
  bkashLastFour String
  status        String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model SellerReport {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  imei       String
  sellerInfo String?
  details    String?
  createdAt  DateTime @default(now())
}

model OwnerMessage {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  imei       String
  ownerEmail String
  message    String
  contact    String?
  createdAt  DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PoliceRecoveryDrive {
  id                String            @id @default(uuid())
  title             String
  agency            String            // e.g. "DMP DB Cyber & Special Crime (North)"
  policeStation     String?           // e.g. "Shahbag Police Station"
  caseNumber        String?
  officerName       String?           // e.g. "এসআই (নিঃ) মো. মনজিল সিদ্দিকী"
  officerContact    String?           // e.g. "01676-271529"
  mediaContact      String?           // e.g. "01320-038001"
  claimInstructions String?           @db.Text // Full legal claim procedure
  sourceUrl         String?
  driveDate         DateTime          @default(now())
  totalDevices      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  devices           RecoveredDevice[]

  @@index([driveDate])
}

model RecoveredDevice {
  id           String              @id @default(uuid())
  driveId      String
  drive        PoliceRecoveryDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  imei1        String?
  imei2        String?
  serialNumber String?
  brand        String?
  model        String?
  rawText      String?
  status       String              @default("IN_POLICE_CUSTODY") // "IN_POLICE_CUSTODY", "CLAIMED_BY_OWNER"
  claimedBy    String?
  claimedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([imei1])
  @@index([imei2])
  @@index([driveId])
}
